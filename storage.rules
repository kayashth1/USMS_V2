rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /library/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /materials/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /notices/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
